{
  "manifest_version": 3,
  "name": "PAYBACK Helper",
  "version": "1.0",
  "description": "Zeigt PAYBACK Punkte und eCoupons für die aktuelle Website an",

  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://www.payback.at/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.payback.at/coupons*"],
      "js": ["intercept-activation.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.payback.at/online-punkten/*",
        "https://www.payback.at/coupons*"
      ],
      "js": ["content-payback.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*/*"],
      "exclude_matches": ["https://www.payback.at/*"],
      "js": ["domain-map.js", "content-notify.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "PAYBACK Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
